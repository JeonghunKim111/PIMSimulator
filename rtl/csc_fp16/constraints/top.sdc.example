# Example only: copy to top.sdc and adjust to the real interface/environment.
create_clock -name core_clk -period 1.000 [get_ports clk]
set_clock_uncertainty 0.050 [get_clocks core_clk]
set_input_delay 0.100 -clock core_clk [remove_from_collection [all_inputs] [get_ports clk]]
set_output_delay 0.100 -clock core_clk [all_outputs]
set_load 0.010 [all_outputs]
